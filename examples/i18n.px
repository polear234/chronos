// ==========================================
// PicoX 中文与国际化终极测试脚本
// ==========================================

print("=== 1. 中文变量与字符串拼接 ===")
// 测试中文字符串和中文变量名
let 问候语 = "你好，PicoX！"
let 开发者 = "NOI 金牌大佬"
print(问候语 + " 我是 " + 开发者)

print("\n=== 2. 中文注释与数组遍历 ===")
let 水果列表 = ["苹果", "香蕉", "橘子"]
for 水果 in 水果列表 {
    // 测试循环中的中文输出
    print("当前水果: " + 水果)
}

print("\n=== 3. 中文高阶函数与管道符 ===")
// 测试管道符和闭包结合中文
水果列表
|> map(fn(水果) { return 水果 + "很好吃" })
|> print()

print("\n=== 4. 面向对象中文类与继承 ===")
class 动物 {
    name = ""
    init(名字) {
        this.name = 名字
    }
    speak() {
        print(this.name + " 发出叫声")
    }
}

class 狗 extends 动物 {
    init(名字) {
        super.init(名字)
    }
    // 方法重写
    speak() {
        print(this.name + " 汪汪叫！")
    }
}

let 我的狗 = new 狗("旺财")
我的狗.speak()

print("\n=== 5. 时间旅行 Traveller 中文测试 ===")
// 配合咱们的时光机机制
let traveller int 血量 = 100
print("初始血量: " + str(血量))

血量 = 50
print("受伤后血量: " + str(血量))

血量.rollback()
print("时光倒流后血量: " + str(血量))

print("\n✅ 中文测试全部执行完毕！")
