<?xml version="1.0" encoding="utf-8"?>
<!--
  Chronos 图标：
    C   = Chronos 首字母（黄色 #FFCC00，开口朝右）
    <   = 代码 / 回溯（白色，与 C 开口留白）
  108x108 画布，内容缩放到中间 72x72 安全区（scale 0.72 + translate 18）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:translateX="18"
        android:translateY="18">

        <!-- 外层 C -->
        <path
            android:pathData="M 75 22 A 35 35 0 1 0 75 78"
            android:strokeColor="#FFCC00"
            android:strokeWidth="12"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- 内部 <（与 C 留出空隙） -->
        <path
            android:pathData="M 66 33 L 48 50 L 66 67"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

    </group>
</vector>
